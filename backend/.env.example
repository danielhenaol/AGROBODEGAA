# Copia este archivo a ".env" (esta ignorado por git) o define estas
# variables en la configuracion de ejecucion de IntelliJ. NUNCA subas valores reales.

# --- Base de datos (Supabase > Connect > Session pooler) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://<HOST>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<ID_DEL_PROYECTO>
SPRING_DATASOURCE_PASSWORD=<tu-contrasena>

# --- Auth0 (pendiente: por ahora no es necesario) ---
#SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://<tu-tenant>.auth0.com/
#SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_AUDIENCES=<tu-audience>

# --- Opcionales ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SPRING_JPA_SHOW_SQL=false
